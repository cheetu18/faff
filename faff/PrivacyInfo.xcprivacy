<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- faff does not track users across apps or websites owned by other companies. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No domains are contacted for tracking purposes. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- faff collects no data. Word lists live only on device (SwiftData) and are
	     never uploaded. Dictionary lookups send only the single word being defined
	     to public reference APIs, with no identifier attached and no response stored
	     off device, which does not constitute collection under Apple's definition. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason APIs. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- ThemeManager persists the selected color pack in UserDefaults. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
